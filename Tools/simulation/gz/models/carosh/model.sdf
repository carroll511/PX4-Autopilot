    <joint name='front_left_femur_joint' type='revolute'>
      <pose relative_to='front_left_coxa'>0.053 0 0 -1.57 0 0</pose>
      <parent>front_left_coxa</parent>
      <child>front_left_femur</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>10</effort>
