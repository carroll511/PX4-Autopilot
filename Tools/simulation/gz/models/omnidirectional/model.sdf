          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Propellers -->
    <!-- Rotor0 -->
    <link name='front_right_upper_rotor'>
        <gravity>true</gravity>
        <velocity_decay/>
        <pose relative_to='front_right_upper_rotor_joint'>0 0 0 0 0 0</pose>
        <inertial>
            <mass>0.01</mass>
            <inertia>
                <ixx>9.6e-7</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>9.6e-7</iyy>
                <iyz>0</iyz>
                <izz>1.9e-6</izz>
            </inertia>
        </inertial>
        <gravity>true</gravity>
        <visual name='front_right_upper_rotor_visual'>
            <geometry>
                <mesh>
                    <scale>0.001 0.001 0.001</scale>
                    <uri>model://omnidirectional/meshes/5045_ccw.stl</uri>
