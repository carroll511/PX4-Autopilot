      </collision>
    </link>
    <joint name='rear_right_tilt_joint' type='revolute'>
      <pose relative_to='base_link'>-0.174541 -0.179137 0 0 0 -0.785398</pose>
      <parent>base_link</parent>
      <child>rear_right_tilt</child>
      <axis>
