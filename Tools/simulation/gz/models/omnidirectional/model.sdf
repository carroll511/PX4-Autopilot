<?xml version="1.0"?>
<sdf version='1.9'>
  <model name='omnidirectional'>
    <self_collide>false</self_collide>
    <pose>1.5 0 0.2 0 0 0</pose>
    <static>false</static>

    <!-- Base Link -->
    <link name='base_link'>
      <inertial>
        <mass>2.326</mass>
        <inertia>
          <ixx>0.024114</ixx>
          <iyy>0.017330</iyy>
          <izz>0.038110</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>

      <collision name='base_link_collision'>
        <geometry>
          <box>
            <size>0.55 0.55 0.045</size>
          </box>
        </geometry>
      </collision>

      <visual name='base_link_visual'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/base.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Barometer -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- Magnetometer -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>80</update_rate>
        <plugin
          filename="gz-sim-magnetometer-system"
          name="gz::sim::systems::Magnetometer">
        </plugin>
      </sensor>

      <!-- GPS Sensor -->
      <sensor name="gps_sensor" type="gps">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <plugin
          filename="gz-sim-navsat-system"
          name="gz::sim::systems::NavSat">
        </plugin>
      </sensor>
    </link>

    <!-- Tilt links -->
    <link name='front_right_tilt'>
      <pose relative_to='front_right_tilt_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.213</mass>
        <inertia>
          <ixx>0.002205</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000090</iyy>
          <iyz>0</iyz>
          <izz>0.002261</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name='front_right_tilt_visual'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='front_right_tilt_collision'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name='front_right_tilt_joint' type='revolute'>
      <pose relative_to='base_link'>0.179137 -0.174541 0 0 0 0.785398</pose>
      <parent>base_link</parent>
      <child>front_right_tilt</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>10</effort>
          <velocity>5</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='front_left_tilt'>
      <pose relative_to='front_left_tilt_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.213</mass>
        <inertia>
          <ixx>0.002205</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000090</iyy>
          <iyz>0</iyz>
          <izz>0.002261</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name='front_left_tilt_visual'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Yellow</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='front_left_tilt_collision'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name='front_left_tilt_joint' type='revolute'>
      <pose relative_to='base_link'>0.174541 0.179137 0 0 0 2.35619</pose>
      <parent>base_link</parent>
      <child>front_left_tilt</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>10</effort>
          <velocity>5</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='rear_left_tilt'>
      <pose relative_to='rear_left_tilt_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.213</mass>
        <inertia>
          <ixx>0.002205</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000090</iyy>
          <iyz>0</iyz>
          <izz>0.002261</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name='rear_left_tilt_visual'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Green</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rear_left_tilt_collision'>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omnidirectional/meshes/arm.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name='rear_left_tilt_joint' type='revolute'>
      <pose relative_to='base_link'>-0.179137 0.174541  0 0 0 -2.35619</pose>
      <parent>base_link</parent>
      <child>rear_left_tilt</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>10</effort>
          <velocity>5</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='rear_right_tilt'>
      <pose relative_to='rear_right_tilt_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.213</mass>
        <inertia>
          <ixx>0.002205</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000090</iyy>
          <iyz>0</iyz>
          <izz>0.002261</izz>
