    </link>
    <joint name='front_right_upper_rotor_joint' type='revolute'>
        <pose relative_to='front_right_tilt'>0 -0.114545 0.049545 0 0 0</pose>
        <parent>front_right_tilt</parent>
        <child>front_right_upper_rotor</child>
        <axis>
            <xyz>0 0 1</xyz>
            <limit>
                <lower>-1e+16</lower>
                <upper>1e+16</upper>
            </limit>
            <dynamics>
                <spring_reference>0</spring_reference>
                <spring_stiffness>0</spring_stiffness>
            </dynamics>
        </axis>
    </joint>
